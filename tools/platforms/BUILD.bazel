# Detect execution platform (where the build runs)
config_setting(
	 name = "exec_x86_64",
	 constraint_values = ["@platforms//cpu:x86_64"],
	 visibility = ["//visibility:public"],
)

config_setting(
	 name = "exec_aarch64",
	 constraint_values = ["@platforms//cpu:aarch64"],
	 visibility = ["//visibility:public"],
)
