load("@bazel_skylib//lib:selects.bzl", "selects")

platform(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "is_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    visibility = ["//visibility:public"],
)

# Detect execution platform (where the build runs)
config_setting(
	 name = "exec_x86_64",
	 constraint_values = ["@platforms//cpu:x86_64"],
	 visibility = ["//visibility:public"],
)

config_setting(
	 name = "exec_aarch64",
	 constraint_values = ["@platforms//cpu:aarch64"],
	 visibility = ["//visibility:public"],
)

# x86_64 execution, x86_64 target (native)
selects.config_setting_group(
	 name = "is_x86_64_target_x86_64",
	 match_all = [
			 ":exec_x86_64",
			 "@platforms//cpu:x86_64",
	 ],
	 visibility = ["//visibility:public"],
)

# x86_64 execution, aarch64 target (cross-compile)
selects.config_setting_group(
	 name = "is_x86_64_target_aarch64",
	 match_all = [
			 ":exec_x86_64",
			 "@platforms//cpu:aarch64",
	 ],
	 visibility = ["//visibility:public"],
)

# aarch64 execution, aarch64 target (native)
selects.config_setting_group(
	 name = "is_aarch64_target_aarch64",
	 match_all = [
			 ":exec_aarch64",
			 "@platforms//cpu:aarch64",
	 ],
	 visibility = ["//visibility:public"],
)

# aarch64 execution, x86_64 target (cross-compile)
selects.config_setting_group(
	 name = "is_aarch64_target_x86_64",
	 match_all = [
			 ":exec_aarch64",
			 "@platforms//cpu:x86_64",
	 ],
	 visibility = ["//visibility:public"],
)
